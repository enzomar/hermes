## Module Design

### `lab/models.py` — Pydantic Types

All wire types and internal domain models. Key classes:

```python
class TaskExpectedOutcome(BaseModel):
    tool_calls: list[str] = []          # ordered when order matters; unordered otherwise
    tool_calls_ordered: bool = False
    assertions: list[str] = []          # substring/regex checks on final LLM output

class Task(BaseModel):
    task_id: str
    dataset_id: str
    dataset_version: int
    prompt: str
    expected: TaskExpectedOutcome

class Dataset(BaseModel):
    dataset_id: str
    version: int
    name: str
    description: str
    tasks: list[Task]
    created_at: datetime

class MCPVersionRegistration(BaseModel):
    mcp_version_id: str
    name: str
    version_tag: str
    transport: Literal["stdio", "sse"]
    connection_config: dict[str, Any]
    schema_snapshot: dict[str, Any]
    registered_at: datetime

class ToolDescriptionVariant(BaseModel):
    variant_id: str
    mcp_version_id: str
    tool_name: str
    description: str
    input_schema: dict[str, Any] | None

class ModelConfig(BaseModel):
    model_config_id: str
    name: str
    provider: str
    model: str
    temperature: float = 0.0
    max_tokens: int = 4096
    system_prompt: str = ""
    api_key_env: str | None = None
    api_base: str | None = None

class WorkflowConfig(BaseModel):
    workflow_config_id: str
    name: str
    system_prompt: str = ""
    max_turns: int = 6
    timeout_seconds: float = 120.0

class RunSpec(BaseModel):
    run_id: str
    experiment_id: str
    task: Task
    model_config: ModelConfig
    mcp_version: MCPVersionRegistration
    tool_variant: ToolDescriptionVariant | None
    workflow_config: WorkflowConfig

class TraceEvent(BaseModel):
    run_id: str
    seq: int
    event_type: str
    ts: datetime
    payload: dict[str, Any]

class EvaluationResult(BaseModel):
    run_id: str
    experiment_id: str
    classification: Literal["success", "partial_success", "failure", "error"]
    tool_call_accuracy: float
    latency_ms: float
    total_tokens: int
    estimated_cost_usd: float
    turn_count: int
    error_field: str | None = None
    detail: dict[str, Any] = {}

class RegressionEntry(BaseModel):
    variant_key: str
    metric: str
    baseline_value: float
    new_value: float
    delta_absolute: float
    delta_relative: float
    direction: Literal["regression", "improvement"]
```

---

### `lab/store.py` — LabStore

Owns all SQLite DDL for Lab tables and provides typed read/write methods. Wraps the same `sqlite3.Connection` as `EventStore` (passed in at construction) to participate in the same WAL file.

```python
class LabStore:
    def __init__(self, conn: sqlite3.Connection, lock: threading.Lock) -> None: ...

    # DDL
    def migrate(self) -> None: ...   # idempotent CREATE TABLE IF NOT EXISTS

    # Datasets
    def create_dataset(self, dataset: Dataset) -> None: ...
    def get_dataset(self, dataset_id: str, version: int) -> Dataset | None: ...
    def list_datasets(self) -> list[dict]: ...
    def delete_dataset_version(self, dataset_id: str, version: int) -> None: ...

    # MCP Registry
    def register_mcp_version(self, reg: MCPVersionRegistration) -> None: ...
    def get_mcp_version(self, mcp_version_id: str) -> MCPVersionRegistration | None: ...
    def list_mcp_versions(self) -> list[MCPVersionRegistration]: ...
    def delete_mcp_version(self, mcp_version_id: str) -> None: ...

    # Tool variants
    def register_tool_variant(self, v: ToolDescriptionVariant) -> None: ...
    def list_tool_variants(self, mcp_version_id: str) -> list[ToolDescriptionVariant]: ...

    # Model configs
    def create_model_config(self, mc: ModelConfig) -> None: ...
    def list_model_configs(self) -> list[ModelConfig]: ...
    def delete_model_config(self, model_config_id: str) -> None: ...

    # Workflow configs
    def create_workflow_config(self, wc: WorkflowConfig) -> None: ...
    def list_workflow_configs(self) -> list[WorkflowConfig]: ...

    # Experiments
    def create_experiment(self, exp_id: str, name: str, variant_links: list[dict]) -> None: ...
    def get_experiment(self, experiment_id: str) -> dict | None: ...
    def list_experiments(self) -> list[dict]: ...
    def set_experiment_status(self, experiment_id: str, status: str, completed_at: str | None = None) -> None: ...
    def delete_experiment(self, experiment_id: str) -> None: ...  # cascades via app logic

    # Runs
    def create_runs(self, runs: list[RunSpec]) -> None: ...  # bulk insert, atomic
    def get_run(self, run_id: str) -> RunSpec | None: ...
    def list_runs(self, experiment_id: str) -> list[dict]: ...
    def set_run_status(self, run_id: str, status: str, started_at: str | None = None, completed_at: str | None = None) -> None: ...

    # Traces
    def append_trace_event(self, event: TraceEvent) -> None: ...
    def seal_trace(self, run_id: str) -> None: ...
    def is_sealed(self, run_id: str) -> bool: ...
    def get_trace(self, run_id: str) -> list[TraceEvent]: ...

    # Evaluation
    def save_eval_result(self, result: EvaluationResult) -> None: ...
    def get_eval_result(self, run_id: str) -> EvaluationResult | None: ...
    def list_eval_results(self, experiment_id: str) -> list[EvaluationResult]: ...

    # Baselines
    def set_baseline(self, experiment_id: str, dataset_id: str, dataset_version: int, variant_key: str) -> str: ...
    def get_baseline(self, dataset_id: str, dataset_version: int, variant_key: str) -> dict | None: ...

    # Regression reports
    def save_regression_report(self, report: dict) -> None: ...
    def get_regression_report(self, experiment_id: str) -> dict | None: ...

    # Mock fixtures
    def save_fixture(self, fixture: dict) -> None: ...
    def get_fixture(self, fixture_id: str) -> dict | None: ...
    def list_fixtures(self) -> list[dict]: ...

    # Reference integrity helpers (used by delete guards)
    def experiments_referencing_dataset(self, dataset_id: str, version: int) -> list[str]: ...
    def experiments_referencing_mcp_version(self, mcp_version_id: str) -> list[str]: ...
```

**Construction wiring** in `WorkbenchBridge.__init__`:
```python
self.lab_store = LabStore(self.store._conn, self.store._lock)
self.lab_store.migrate()
```

